# EduERP v2.0 — Local Development Environment Example (.env.example)
# IMPORTANT: Contains ONLY safe non-secret development placeholders (T03.03, T04.02, T05.01, G03).
# Never commit a real .env file, production password, JWT secret, or Telegram token.
# Variable names match API_CANONICAL_ENV_KEYS in apps/api/src/config/env.ts 1-for-1 (G03).

NODE_ENV=development
LOG_LEVEL=info

# Isolated Center Identity (Per-Center Data Plane)
CENTER_ID=11111111-2222-4333-8444-555555555555
CENTER_SLUG=guliston-ilm
CENTER_TIMEZONE=Asia/Tashkent
LICENSE_MODE=ACTIVE

# API Server Binding, Reverse Proxy & Trusted Browser Origins (G03)
API_HOST=0.0.0.0
API_PORT=3000
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://guliston-ilm.eduerp.uz

# Local PostgreSQL Bootstrap Admin (used ONLY by container init; never by API/Worker runtime)
POSTGRES_DB=eduerp_guliston_ilm_dev
POSTGRES_USER=eduerp_pg_superuser
POSTGRES_PASSWORD=EXAMPLE_DEV_ONLY_REPLACE_ME_NotARealDbPassword

# Least-Privilege Separated PostgreSQL Roles (Stage 04 — T04.02, F06, G03)
# MIGRATION_DATABASE_URL is consumed ONLY by the dedicated migrator CLI job, never by API/Worker runtime.
MIGRATION_DATABASE_URL=postgresql://eduerp_migrator:EXAMPLE_DEV_ONLY_MIGRATOR_PASS@postgres:5432/eduerp_guliston_ilm_dev?schema=public
DATABASE_URL=postgresql://eduerp_api_runtime:EXAMPLE_DEV_ONLY_API_RUNTIME_PASS@postgres:5432/eduerp_guliston_ilm_dev?schema=public
WORKER_DATABASE_URL=postgresql://eduerp_worker_runtime:EXAMPLE_DEV_ONLY_WORKER_RUNTIME_PASS@postgres:5432/eduerp_guliston_ilm_dev?schema=public
READONLY_DATABASE_URL=postgresql://eduerp_readonly:EXAMPLE_DEV_ONLY_READONLY_PASS@postgres:5432/eduerp_guliston_ilm_dev?schema=public
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000

# Staff Auth, Session TTL, Lockout, Rate Limit, Scrypt Concurrency & Bot Boundary Secrets (Stage 05 — T05.01, G03, G06)
JWT_ACCESS_SECRET=EXAMPLE_DEV_ONLY_JWT_ACCESS_SECRET_REPLACE_ME_0001
JWT_REFRESH_SECRET=EXAMPLE_DEV_ONLY_JWT_REFRESH_SECRET_REPLACE_ME_0002
JWT_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=604800
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=20
PASSWORD_HASH_MAX_CONCURRENCY=4
PASSWORD_HASH_MAX_QUEUE=64
INTERNAL_BOT_HMAC_SECRET=EXAMPLE_DEV_ONLY_INTERNAL_BOT_HMAC_SECRET_REPLACE_03
TELEGRAM_WEBHOOK_SECRET=EXAMPLE_DEV_ONLY_TG_WEBHOOK_SECRET_04

# Worker Foundation Configuration (Stage 03/04 foundation; outbox business jobs start in Stage 13)
WORKER_ID=worker-guliston-ilm-dev-01
WORKER_POLL_INTERVAL_MS=500
WORKER_SHUTDOWN_TIMEOUT_MS=5000
BOT_OUTBOUND_ENABLED=false
