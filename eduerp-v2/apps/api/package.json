{
  "name": "@eduerp/api",
  "version": "2.0.0-s05.0",
  "private": true,
  "description": "EduERP v2.0 Center Data Plane NestJS API, PostgreSQL/Prisma 7 Database Foundation, and Staff Auth/RBAC (Stages 04–09)",
  "main": "dist/src/main.js",
  "scripts": {
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "test": "node --test dist/test/*.test.js",
    "test:db": "node --test dist/test/database/*.integration.test.js",
    "test:auth": "node --test dist/test/auth/*.integration.test.js",
    "test:students": "node --test dist/test/students/*.integration.test.js",
    "test:academics": "node --test dist/test/academics/*.integration.test.js",
    "test:billing": "node --test dist/test/billing/*.integration.test.js",
    "test:adjustments": "node --test dist/test/adjustments/*.integration.test.js",
    "test:payments": "node --test dist/test/payments/*.integration.test.js",
    "test:cash": "node --test dist/test/cash/*.integration.test.js"
  },
  "dependencies": {
    "@eduerp/contracts": "2.0.0-s03.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
