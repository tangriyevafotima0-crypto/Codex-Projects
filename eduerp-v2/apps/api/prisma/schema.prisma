// EduERP v2.0 — Canonical 46-Entity Prisma 7 Schema (apps/api/prisma/schema.prisma)
// Step 04.01 (T04.01):
// - Maps all 46 canonical entities (25 Mutable + 21 Strictly Append-Only) 1-to-1 to snake_case PostgreSQL tables.
// - All UZS monetary columns use @db.BigInt (scale=0, 1 integer = 1 UZS so'm; no float or Number precision loss).
// - All foreign keys enforce OnDelete: Restrict, OnUpdate: Restrict (no cascade delete of financial/audit history).
// - PostgreSQL CHECK constraints, partial unique indexes, composite tenant FKs, and append-only immutability triggers
//   are enforced in apps/api/prisma/migrations/20261104000100_initial_foundation/migration.sql.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model CenterLicense {
  centerId               String   @id @map("center_id") @db.Uuid
  centerSlug             String   @unique @map("center_slug") @db.VarChar(64)
  licenseStatus          String   @map("license_status") @db.VarChar(16)
  signedJwtToken         String   @map("signed_jwt_token") @db.Text
  signatureKeyId         String   @map("signature_key_id") @db.VarChar(32)
  validUntilUtc          DateTime @map("valid_until_utc") @db.Timestamptz(6)
  graceUntilUtc          DateTime @map("grace_until_utc") @db.Timestamptz(6)
  lastVerifiedAtUtc      DateTime @map("last_verified_at_utc") @db.Timestamptz(6)
  updatedByVendorAuditId String?  @map("updated_by_vendor_audit_id") @db.Uuid
  version                Int      @default(1)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("center_licenses")
}

model StaffUser {
  id                 String    @id @default(uuid()) @db.Uuid
  centerId           String    @map("center_id") @db.Uuid
  role               String    @db.VarChar(16)
  fullName           String    @map("full_name") @db.VarChar(120)
  loginUsername      String    @map("login_username") @db.VarChar(64)
  phoneE164          String?   @map("phone_e164") @db.VarChar(20)
  telegramUserId     BigInt?   @map("telegram_user_id") @db.BigInt
  passwordHash       String    @map("password_hash") @db.Text
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  status             String    @db.VarChar(16)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions               StaffSession[]
  primaryGroups          CourseGroup[]          @relation("GroupPrimaryTeacher")
  originalSubstitutes    SubstituteAssignment[] @relation("SubstituteOriginalTeacher")
  substituteAssignments  SubstituteAssignment[] @relation("SubstituteReplacementTeacher")
  assignedSubstitutes    SubstituteAssignment[] @relation("SubstituteAssignedByAdmin")
  recordedAttendances    AttendanceRecord[]     @relation("AttendanceRecordedBy")
  attendanceRevisions    AttendanceRevision[]   @relation("AttendanceRevisionActor")
  recordedGrades         GradeEntry[]           @relation("GradeRecordedByTeacher")
  coursePriceChanges     CoursePriceHistory[]   @relation("CoursePriceChangedBy")
  discountRequests       DiscountRequest[]      @relation("DiscountRequestedByAdmin")
  discountApprovals      DiscountApproval[]     @relation("DiscountApprovedByDirector")
  freezeRecords          FreezeRecord[]         @relation("FreezeCreatedByAdmin")
  openedCashShifts       CashShift[]            @relation("CashShiftOpenedBy")
  closedCashShifts       CashShift[]            @relation("CashShiftClosedBy")
  recordedPayments       Payment[]              @relation("PaymentRecordedByAdmin")
  reversalRequests       ReversalOrRefundRequest[] @relation("ReversalRequestedByAdmin")
  reversalDecisions      ReversalOrRefundRequest[] @relation("ReversalDecidedByDirector")
  reversalExecutions     ReversalOrRefundExecution[] @relation("ReversalExecutedByDirector")
  recordedCashExpenses   CashExpense[]          @relation("CashExpenseRecordedBy")
  actorLedgerEntries     LedgerEntry[]          @relation("LedgerActorStaff")
  teacherPayrolls        PayrollSnapshot[]      @relation("PayrollTeacher")
  closedPayrolls         PayrollSnapshot[]      @relation("PayrollClosedByDirector")
  teacherPayrollAdjusts  PayrollAdjustment[]    @relation("PayrollAdjustmentTeacher")
  createdPayrollAdjusts  PayrollAdjustment[]    @relation("PayrollAdjustmentCreatedBy")
  uploadedImportBatches  ImportBatch[]          @relation("ImportBatchUploadedBy")

  @@unique([id, centerId])
  @@unique([centerId, loginUsername])
  @@index([centerId, role, status])
  @@map("staff_users")
}

model StaffSession {
  id               String    @id @default(uuid()) @db.Uuid
  centerId         String    @map("center_id") @db.Uuid
  staffId          String    @map("staff_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  roleSnapshot     String    @map("role_snapshot") @db.VarChar(16)
  deviceInfo       String?   @map("device_info") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(64)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  staff StaffUser @relation(fields: [staffId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffId, revokedAt])
  @@map("staff_sessions")
}

model Student {
  id             String    @id @default(uuid()) @db.Uuid
  centerId       String    @map("center_id") @db.Uuid
  studentCode    String    @map("student_code") @db.VarChar(24)
  fullName       String    @map("full_name") @db.VarChar(120)
  normalizedName String    @map("normalized_name") @db.VarChar(120)
  birthDate      DateTime? @map("birth_date") @db.Date
  status         String    @db.VarChar(16)
  notes          String?   @db.Text
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  guardianLinks     GuardianStudent[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  gradeEntries      GradeEntry[]
  invoices          Invoice[]
  discountRequests  DiscountRequest[]
  creditNotes       CreditNote[]
  payments          Payment[]
  unappliedCredits  UnappliedCredit[]
  receipts          Receipt[]
  promisesToPay     PromiseToPay[]
  ledgerEntries     LedgerEntry[]

  @@unique([id, centerId])
  @@unique([centerId, studentCode])
  @@index([centerId, normalizedName, status])
  @@map("students")
}

model Guardian {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @map("center_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(120)
  phoneE164 String   @map("phone_e164") @db.VarChar(20)
  status    String   @db.VarChar(16)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  studentLinks  GuardianStudent[]
  telegramLinks GuardianTelegramLink[]

  @@unique([id, centerId])
  @@unique([centerId, phoneE164])
  @@map("guardians")
}

model GuardianStudent {
  id             String    @id @default(uuid()) @db.Uuid
  centerId       String    @map("center_id") @db.Uuid
  guardianId     String    @map("guardian_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  relationship   String    @db.VarChar(32)
  isPrimaryPayer Boolean   @default(true) @map("is_primary_payer")
  active         Boolean   @default(true)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  unlinkedAt     DateTime? @map("unlinked_at") @db.Timestamptz(6)

  guardian Guardian @relation(fields: [guardianId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  student  Student  @relation(fields: [studentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([guardianId, studentId])
  @@index([studentId, active])
  @@map("guardian_students")
}

model GuardianTelegramLink {
  id                 String    @id @default(uuid()) @db.Uuid
  centerId           String    @map("center_id") @db.Uuid
  guardianId         String    @map("guardian_id") @db.Uuid
  inviteTokenHash    String    @unique @map("invite_token_hash") @db.Char(64)
  inviteExpiresAt    DateTime  @map("invite_expires_at") @db.Timestamptz(6)
  inviteUsedAt       DateTime? @map("invite_used_at") @db.Timestamptz(6)
  telegramUserId     BigInt?   @map("telegram_user_id") @db.BigInt
  telegramChatId     BigInt?   @map("telegram_chat_id") @db.BigInt
  linkedPhoneE164    String    @map("linked_phone_e164") @db.VarChar(20)
  status             String    @db.VarChar(24)
  lastDeliveryStatus String?   @map("last_delivery_status") @db.VarChar(24)
  lastErrorAt        DateTime? @map("last_error_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason       String?   @map("revoke_reason") @db.VarChar(64)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  guardian Guardian @relation(fields: [guardianId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([centerId, telegramChatId, status])
  @@map("guardian_telegram_links")
}

model Course {
  id                     String   @id @default(uuid()) @db.Uuid
  centerId               String   @map("center_id") @db.Uuid
  name                   String   @db.VarChar(100)
  defaultMonthlyFeeUzs   BigInt   @map("default_monthly_fee_uzs") @db.BigInt
  defaultLessonsPerCycle Int      @default(12) @map("default_lessons_per_cycle")
  status                 String   @db.VarChar(16)
  version                Int      @default(1)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  priceHistory CoursePriceHistory[]
  groups       CourseGroup[]

  @@unique([id, centerId])
  @@unique([centerId, name])
  @@map("courses")
}

model CoursePriceHistory {
  id               String   @id @default(uuid()) @db.Uuid
  centerId         String   @map("center_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  groupId          String?  @map("group_id") @db.Uuid
  previousFeeUzs   BigInt   @map("previous_fee_uzs") @db.BigInt
  newFeeUzs        BigInt   @map("new_fee_uzs") @db.BigInt
  effectiveFrom    DateTime @map("effective_from") @db.Date
  changedByStaffId String   @map("changed_by_staff_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course         Course    @relation(fields: [courseId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  changedByStaff StaffUser @relation("CoursePriceChangedBy", fields: [changedByStaffId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([courseId, effectiveFrom])
  @@map("course_price_history")
}

model CourseGroup {
  id               String   @id @default(uuid()) @db.Uuid
  centerId         String   @map("center_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  name             String   @db.VarChar(100)
  primaryTeacherId String   @map("primary_teacher_id") @db.Uuid
  billingMode      String   @map("billing_mode") @db.VarChar(24)
  currentFeeUzs    BigInt   @map("current_fee_uzs") @db.BigInt
  lessonsPerCycle  Int      @default(12) @map("lessons_per_cycle")
  scheduleDaysJson Json     @map("schedule_days_json")
  startsTime       String   @map("starts_time") @db.VarChar(8)
  durationMinutes  Int      @map("duration_minutes")
  timezone         String   @default("Asia/Tashkent") @db.VarChar(64)
  status           String   @db.VarChar(16)
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  course            Course             @relation(fields: [courseId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  primaryTeacher    StaffUser          @relation("GroupPrimaryTeacher", fields: [primaryTeacherId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  enrollments       Enrollment[]
  lessonOccurrences LessonOccurrence[]

  @@unique([id, centerId])
  @@index([centerId, primaryTeacherId, status])
  @@map("course_groups")
}

model Enrollment {
  id                       String    @id @default(uuid()) @db.Uuid
  centerId                 String    @map("center_id") @db.Uuid
  studentId                String    @map("student_id") @db.Uuid
  groupId                  String    @map("group_id") @db.Uuid
  status                   String    @db.VarChar(16)
  enrolledAtDate           DateTime  @map("enrolled_at_date") @db.Date
  firstTrialLessonId       String?   @map("first_trial_lesson_id") @db.Uuid
  firstTrialDate           DateTime? @map("first_trial_date") @db.Date
  activatedAt              DateTime? @map("activated_at") @db.Timestamptz(6)
  billingAnchorDay         Int?      @map("billing_anchor_day") @db.SmallInt
  packageLessonsRemaining  Int?      @map("package_lessons_remaining")
  leftAtDate               DateTime? @map("left_at_date") @db.Date
  churnReasonCode          Int?      @map("churn_reason_code") @db.SmallInt
  churnAttributedTeacherId String?   @map("churn_attributed_teacher_id") @db.Uuid
  churnNotes               String?   @map("churn_notes") @db.Text
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  student           Student            @relation(fields: [studentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  group             CourseGroup        @relation(fields: [groupId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  attendanceRecords AttendanceRecord[]
  gradeEntries      GradeEntry[]
  trialActivations  TrialActivation[]
  billingCycles     BillingCycle[]
  invoices          Invoice[]
  discountRequests  DiscountRequest[]
  freezeRecords     FreezeRecord[]
  freezeLessonLinks FreezeLessonLink[]
  creditNotes       CreditNote[]

  @@unique([id, centerId])
  @@index([studentId, status])
  @@map("enrollments")
}

model LessonOccurrence {
  id                      String    @id @default(uuid()) @db.Uuid
  centerId                String    @map("center_id") @db.Uuid
  groupId                 String    @map("group_id") @db.Uuid
  lessonDate              DateTime  @map("lesson_date") @db.Date
  occurrenceSeq           Int       @default(1) @map("occurrence_seq") @db.SmallInt
  startsAtUtc             DateTime  @map("starts_at_utc") @db.Timestamptz(6)
  endsAtUtc               DateTime  @map("ends_at_utc") @db.Timestamptz(6)
  status                  String    @db.VarChar(20)
  rescheduledFromLessonId String?   @map("rescheduled_from_lesson_id") @db.Uuid
  primaryTeacherSnapshotId String   @map("primary_teacher_snapshot_id") @db.Uuid
  payRecipientTeacherId   String    @map("pay_recipient_teacher_id") @db.Uuid
  attendanceSubmittedAt   DateTime? @map("attendance_submitted_at") @db.Timestamptz(6)
  attendanceSubmittedBy   String?   @map("attendance_submitted_by") @db.Uuid
  teacherPingSentAt       DateTime? @map("teacher_ping_sent_at") @db.Timestamptz(6)
  adminEscalationSentAt   DateTime? @map("admin_escalation_sent_at") @db.Timestamptz(6)
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  group                 CourseGroup            @relation(fields: [groupId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  substituteAssignments SubstituteAssignment[]
  attendanceRecords     AttendanceRecord[]
  gradeEntries          GradeEntry[]
  freezeLessonLinks     FreezeLessonLink[]

  @@unique([id, centerId])
  @@unique([groupId, lessonDate, occurrenceSeq])
  @@unique([groupId, startsAtUtc])
  @@index([centerId, status, startsAtUtc])
  @@map("lesson_occurrences")
}

model SubstituteAssignment {
  id                     String    @id @default(uuid()) @db.Uuid
  centerId               String    @map("center_id") @db.Uuid
  lessonId               String    @map("lesson_id") @db.Uuid
  originalTeacherId      String    @map("original_teacher_id") @db.Uuid
  substituteTeacherId    String    @map("substitute_teacher_id") @db.Uuid
  assignedByAdminId      String    @map("assigned_by_admin_id") @db.Uuid
  reason                 String    @db.VarChar(255)
  status                 String    @db.VarChar(16)
  paySharePolicySnapshot String    @map("pay_share_policy_snapshot") @db.VarChar(32)
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)

  lesson            LessonOccurrence @relation(fields: [lessonId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  originalTeacher   StaffUser        @relation("SubstituteOriginalTeacher", fields: [originalTeacherId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  substituteTeacher StaffUser        @relation("SubstituteReplacementTeacher", fields: [substituteTeacherId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  assignedByAdmin   StaffUser        @relation("SubstituteAssignedByAdmin", fields: [assignedByAdminId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, centerId])
  @@index([lessonId, status])
  @@map("substitute_assignments")
}

model AttendanceRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  centerId            String   @map("center_id") @db.Uuid
  lessonId            String   @map("lesson_id") @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  enrollmentId        String   @map("enrollment_id") @db.Uuid
  status              String   @db.VarChar(16)
  isExcusedFrozen     Boolean  @default(false) @map("is_excused_frozen")
  sourceChannel       String   @map("source_channel") @db.VarChar(20)
  recordedByStaffId   String   @map("recorded_by_staff_id") @db.Uuid
  overrideReason      String?  @map("override_reason") @db.Text
  clientOperationUuid String   @map("client_operation_uuid") @db.Uuid
  version             Int      @default(1)
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  lesson          LessonOccurrence     @relation(fields: [lessonId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  student         Student              @relation(fields: [studentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  enrollment      Enrollment           @relation(fields: [enrollmentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  recordedByStaff StaffUser            @relation("AttendanceRecordedBy", fields: [recordedByStaffId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  revisions       AttendanceRevision[]

  @@unique([id, centerId])
  @@unique([lessonId, studentId])
  @@map("attendance_records")
}

model AttendanceRevision {
  id                  String   @id @default(uuid()) @db.Uuid
  centerId            String   @map("center_id") @db.Uuid
  attendanceRecordId  String   @map("attendance_record_id") @db.Uuid
  revisionVersion     Int      @map("revision_version")
  previousStatus      String?  @map("previous_status") @db.VarChar(16)
  newStatus           String   @map("new_status") @db.VarChar(16)
  sourceChannel       String   @map("source_channel") @db.VarChar(20)
  actorStaffId        String   @map("actor_staff_id") @db.Uuid
  reason              String?  @db.Text
  clientOperationUuid String   @map("client_operation_uuid") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  actorStaff       StaffUser        @relation("AttendanceRevisionActor", fields: [actorStaffId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([attendanceRecordId, revisionVersion])
  @@map("attendance_revisions")
}

model ClientOperationLog {
  clientOperationUuid String   @id @map("client_operation_uuid") @db.Uuid
  centerId            String   @map("center_id") @db.Uuid
  actorId             String   @map("actor_id") @db.Uuid
  operationType       String   @map("operation_type") @db.VarChar(48)
  requestBodySha256   String   @map("request_body_sha256") @db.Char(64)
  responseStatusCode  Int      @map("response_status_code")
  responsePayloadJson Json     @map("response_payload_json")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([centerId, actorId, operationType, clientOperationUuid])
  @@map("client_operation_logs")
}

model GradeEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  centerId            String   @map("center_id") @db.Uuid
  lessonId            String   @map("lesson_id") @db.Uuid
  enrollmentId        String   @map("enrollment_id") @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  score               Decimal  @db.Decimal(5, 2)
  commentSanitized    String?  @map("comment_sanitized") @db.VarChar(500)
  recordedByTeacherId String   @map("recorded_by_teacher_id") @db.Uuid
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  lesson            LessonOccurrence @relation(fields: [lessonId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  enrollment        Enrollment       @relation(fields: [enrollmentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  student           Student          @relation(fields: [studentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  recordedByTeacher StaffUser        @relation("GradeRecordedByTeacher", fields: [recordedByTeacherId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([lessonId, studentId])
  @@map("grade_entries")
}

model BillingPolicyVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  centerId            String   @map("center_id") @db.Uuid
  versionNumber       Int      @map("version_number")
  billingMode         String   @map("billing_mode") @db.VarChar(24)
  roundingMode        String   @map("rounding_mode") @db.VarChar(24)
  discountStackingMode String  @map("discount_stacking_mode") @db.VarChar(24)
  freezeCreditBasis   String   @map("freeze_credit_basis") @db.VarChar(32)
