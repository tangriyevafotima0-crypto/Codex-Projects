  centerId          String    @map("center_id") @db.Uuid
  templateType      String    @map("template_type") @db.VarChar(24)
  templateVersion   String    @map("template_version") @db.VarChar(16)
  uploadSha256      String    @map("upload_sha256") @db.Char(64)
  previewTokenHash  String    @unique @map("preview_token_hash") @db.Char(64)
  previewExpiresAt  DateTime  @map("preview_expires_at") @db.Timestamptz(6)
  totalRows         Int       @map("total_rows")
  validRows         Int       @map("valid_rows")
  errorRows         Int       @map("error_rows")
  previewReportJson Json      @map("preview_report_json")
  status            String    @db.VarChar(20)
