model LedgerEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  centerId            String   @map("center_id") @db.Uuid
  entrySeq            BigInt   @default(autoincrement()) @map("entry_seq") @db.BigInt
  entryType           String   @map("entry_type") @db.VarChar(32)
  studentId           String?  @map("student_id") @db.Uuid
  invoiceId           String?  @map("invoice_id") @db.Uuid
  paymentId           String?  @map("payment_id") @db.Uuid
  reversalExecutionId String?  @map("reversal_execution_id") @db.Uuid
  creditNoteId        String?  @map("credit_note_id") @db.Uuid
  cashExpenseId       String?  @map("cash_expense_id") @db.Uuid
  direction           String   @db.VarChar(6)
  amountUzs           BigInt   @map("amount_uzs") @db.BigInt
  paymentMethod       String?  @map("payment_method") @db.VarChar(16)
  actorType           String   @map("actor_type") @db.VarChar(16)
  actorStaffId        String?  @map("actor_staff_id") @db.Uuid
  systemJobName       String?  @map("system_job_name") @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student           Student?                   @relation(fields: [studentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  invoice           Invoice?                   @relation(fields: [invoiceId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  payment           Payment?                   @relation(fields: [paymentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  reversalExecution ReversalOrRefundExecution? @relation(fields: [reversalExecutionId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  creditNote        CreditNote?                @relation(fields: [creditNoteId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  cashExpense       CashExpense?               @relation(fields: [cashExpenseId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  actorStaff        StaffUser?                 @relation("LedgerActorStaff", fields: [actorStaffId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([centerId, entrySeq])
  @@map("ledger_entries")
}

model PayrollSnapshot {
  id                      String    @id @default(uuid()) @db.Uuid
  centerId                String    @map("center_id") @db.Uuid
  periodKey               String    @map("period_key") @db.Char(7)
  teacherId               String    @map("teacher_id") @db.Uuid
  payrollModelSnapshot    String    @map("payroll_model_snapshot") @db.VarChar(24)
  primaryLessonsTaught    Int       @default(0) @map("primary_lessons_taught")
  substituteLessonsTaught Int       @default(0) @map("substitute_lessons_taught")
  baseEarnedUzs           BigInt    @map("base_earned_uzs") @db.BigInt
  substituteEarnedUzs     BigInt    @map("substitute_earned_uzs") @db.BigInt
  adjustmentsTotalUzs     BigInt    @default(0) @map("adjustments_total_uzs") @db.BigInt
  netPayableUzs           BigInt    @map("net_payable_uzs") @db.BigInt
  status                  String    @db.VarChar(16)
  closedByDirectorId      String?   @map("closed_by_director_id") @db.Uuid
  closedAt                DateTime? @map("closed_at") @db.Timestamptz(6)
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  teacher          StaffUser           @relation("PayrollTeacher", fields: [teacherId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  closedByDirector StaffUser?          @relation("PayrollClosedByDirector", fields: [closedByDirectorId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  adjustments      PayrollAdjustment[]

  @@unique([id, centerId])
  @@unique([centerId, periodKey, teacherId])
  @@map("payroll_snapshots")
}

model PayrollAdjustment {
  id                       String   @id @default(uuid()) @db.Uuid
  centerId                 String   @map("center_id") @db.Uuid
  targetCurrentSnapshotId  String   @map("target_current_snapshot_id") @db.Uuid
  referenceClosedPeriodKey String   @map("reference_closed_period_key") @db.Char(7)
  teacherId                String   @map("teacher_id") @db.Uuid
  deltaAmountUzs           BigInt   @map("delta_amount_uzs") @db.BigInt
  reason                   String   @db.Text
  createdByDirectorId      String   @map("created_by_director_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  targetCurrentSnapshot PayrollSnapshot @relation(fields: [targetCurrentSnapshotId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  teacher               StaffUser       @relation("PayrollAdjustmentTeacher", fields: [teacherId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  createdByDirector     StaffUser       @relation("PayrollAdjustmentCreatedBy", fields: [createdByDirectorId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([targetCurrentSnapshotId])
  @@map("payroll_adjustments")
}

model AuditLog {
  id                 String   @id @default(uuid()) @db.Uuid
  centerId           String   @map("center_id") @db.Uuid
  actorType          String   @map("actor_type") @db.VarChar(16)
  actorId            String?  @map("actor_id") @db.Uuid
  actorRole          String?  @map("actor_role") @db.VarChar(16)
  action             String   @db.VarChar(64)
  entityType         String   @map("entity_type") @db.VarChar(48)
  entityId           String   @map("entity_id") @db.Uuid
  severity           String   @default("INFO") @db.VarChar(16)
  beforeRedactedJson Json?    @map("before_redacted_json")
  afterRedactedJson  Json?    @map("after_redacted_json")
  requestId          String   @map("request_id") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([centerId, entityType, entityId])
  @@map("audit_logs")
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  centerId         String    @map("center_id") @db.Uuid
  eventName        String    @map("event_name") @db.VarChar(64)
  schemaVersion    Int       @default(1) @map("schema_version")
  aggregateType    String    @map("aggregate_type") @db.VarChar(48)
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  dedupKey         String    @unique @map("dedup_key") @db.VarChar(160)
  payloadJson      Json      @map("payload_json")
  status           String    @db.VarChar(24)
  attemptCount     Int       @default(0) @map("attempt_count")
  leaseToken       BigInt    @default(0) @map("lease_token") @db.BigInt
  leasedByWorker   String?   @map("leased_by_worker") @db.VarChar(64)
  leaseUntil       DateTime? @map("lease_until") @db.Timestamptz(6)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError        String?   @map("last_error") @db.Text
  occurredAtUtc    DateTime  @default(now()) @map("occurred_at_utc") @db.Timestamptz(6)
  processedAtUtc   DateTime? @map("processed_at_utc") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  consumerReceipts       OutboxConsumerReceipt[]
  notificationDeliveries NotificationDelivery[]

  @@unique([id, centerId])
  @@unique([centerId, aggregateType, aggregateId, aggregateVersion])
  @@index([centerId, status, nextAttemptAt, occurredAtUtc])
  @@map("outbox_events")
}

model OutboxConsumerReceipt {
  id                 String   @id @default(uuid()) @db.Uuid
  centerId           String   @map("center_id") @db.Uuid
  outboxEventId      String   @map("outbox_event_id") @db.Uuid
  consumerName       String   @map("consumer_name") @db.VarChar(64)
  consumerReceiptKey String   @map("consumer_receipt_key") @db.VarChar(192)
  fencingLeaseToken  BigInt   @map("fencing_lease_token") @db.BigInt
  effectSummaryJson  Json     @map("effect_summary_json")
  processedAtUtc     DateTime @default(now()) @map("processed_at_utc") @db.Timestamptz(6)

  outboxEvent OutboxEvent @relation(fields: [outboxEventId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([centerId, consumerName, outboxEventId])
  @@unique([centerId, consumerReceiptKey])
  @@map("outbox_consumer_receipts")
}

model NotificationDelivery {
  id                 String   @id @default(uuid()) @db.Uuid
  centerId           String   @map("center_id") @db.Uuid
  outboxEventId      String   @map("outbox_event_id") @db.Uuid
  recipientType      String   @map("recipient_type") @db.VarChar(16)
  recipientId        String   @map("recipient_id") @db.Uuid
  telegramChatId     BigInt?  @map("telegram_chat_id") @db.BigInt
  deliveryStatus     String   @map("delivery_status") @db.VarChar(24)
  attemptCount       Int      @default(0) @map("attempt_count")
  nextAttemptAt      DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastLeaseToken     BigInt   @default(0) @map("last_lease_token") @db.BigInt
  telegramMessageId  BigInt?  @map("telegram_message_id") @db.BigInt
  retryAfterSeconds  Int?     @map("retry_after_seconds")
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  outboxEvent OutboxEvent @relation(fields: [outboxEventId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([outboxEventId, recipientType, recipientId])
  @@map("notification_deliveries")
}

model ImportBatch {
