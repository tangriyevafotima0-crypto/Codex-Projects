  paymentId                String    @unique @map("payment_id") @db.Uuid
  studentId                String    @map("student_id") @db.Uuid
  amountUzs                BigInt    @map("amount_uzs") @db.BigInt
  paymentMethod            String    @map("payment_method") @db.VarChar(16)
  remainingDebtSnapshotUzs BigInt    @map("remaining_debt_snapshot_uzs") @db.BigInt
  nextDueDateSnapshot      DateTime? @map("next_due_date_snapshot") @db.Date
  isFiscalTaxReceipt       Boolean   @default(false) @map("is_fiscal_tax_receipt")
  issuedAt                 DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  student Student @relation(fields: [studentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([centerId, receiptNumber])
  @@map("receipts")
}

model PromiseToPay {
  id                String    @id @default(uuid()) @db.Uuid
  centerId          String    @map("center_id") @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  invoiceId         String    @map("invoice_id") @db.Uuid
  triggerPaymentId  String    @map("trigger_payment_id") @db.Uuid
  promisedAmountUzs BigInt    @map("promised_amount_uzs") @db.BigInt
  promiseDate       DateTime  @map("promise_date") @db.Date
  status            String    @db.VarChar(16)
  reminderSentAt    DateTime? @map("reminder_sent_at") @db.Timestamptz(6)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  student        Student @relation(fields: [studentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  invoice        Invoice @relation(fields: [invoiceId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  triggerPayment Payment @relation(fields: [triggerPaymentId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([centerId, status, promiseDate])
  @@map("promises_to_pay")
}

model CashExpense {
  id                String   @id @default(uuid()) @db.Uuid
  centerId          String   @map("center_id") @db.Uuid
  cashShiftId       String   @map("cash_shift_id") @db.Uuid
  category          String   @db.VarChar(48)
  amountUzs         BigInt   @map("amount_uzs") @db.BigInt
  paymentMethod     String   @map("payment_method") @db.VarChar(16)
  reasonAndDoc      String   @map("reason_and_doc") @db.VarChar(255)
  reversesExpenseId String?  @map("reverses_expense_id") @db.Uuid
  recordedByStaffId String   @map("recorded_by_staff_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cashShift       CashShift     @relation(fields: [cashShiftId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  recordedByStaff StaffUser     @relation("CashExpenseRecordedBy", fields: [recordedByStaffId, centerId], references: [id, centerId], onDelete: Restrict, onUpdate: Restrict)
  ledgerEntries   LedgerEntry[]

  @@unique([id, centerId])
  @@map("cash_expenses")
